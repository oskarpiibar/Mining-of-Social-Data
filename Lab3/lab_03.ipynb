    "from collections import defaultdict\n",
    "\n",
    "# Positions are actors with the same exact set of other Louvain communities\n",
    "# reached by at least one retweet tie. The actor's own community is excluded;\n",
    "# only actors bridging at least two other communities are retained.\n",
    "position_graph = g_und\n",
    "position_memb = np.asarray(partitions[CHOSEN])\n",
    "community_ids = sorted(set(position_memb.tolist()))\n",
    "community_col = {c: j for j, c in enumerate(community_ids)}\n",
    "affiliation = np.zeros((position_graph.vcount(), len(community_ids)), dtype=np.uint8)\n",
    "position_groups = defaultdict(list)\n",
    "position_rows = []\n",
    "for actor in range(position_graph.vcount()):\n",
    "    outside = sorted({position_memb[neighbor] for neighbor in position_graph.neighbors(actor)\n",
    "                      if position_memb[neighbor] != position_memb[actor]})\n",
    "    if len(outside) >= 2:\n",
    "        affiliation[actor, [community_col[c] for c in outside]] = 1\n",
    "        signature = tuple(outside)\n",
    "        position_groups[signature].append(actor)\n",
    "        position_rows.append({\n",
    "            'account_id': position_graph.vs[actor]['name'],\n",
    "            'own_community': int(position_memb[actor]),\n",
    "            'bridge_communities': ','.join(map(str, signature)),\n",
    "            'number_of_other_communities': len(signature),\n",
    "            'degree': position_graph.degree(actor),\n",
    "            'weighted_strength': position_graph.strength(actor, weights='weight')\n",
    "        })\n",
    "\n",
    "position_summary = pd.DataFrame([\n",
    "    {'bridge_communities': ','.join(map(str, signature)),\n",
    "     'number_of_communities': len(signature), 'actors': len(actors)}\n",
    "    for signature, actors in position_groups.items()\n",
    "]).sort_values(['actors', 'number_of_communities'], ascending=False)\n",
    "print(f'Affiliation matrix: {position_graph.vcount()} actors x '\n",
    "      f'{len(community_ids)} communities; {len(position_rows)} actors reach 2+ '\n",
    "      f'other communities; {sum(len(v) >= 2 for v in position_groups.values())} '\n",
    "      f'exact positions contain at least two actors.')\n",
    "display(position_summary.head(15))\n",
    "pd.DataFrame(position_rows).to_csv(str(DATA / 'retweet_bridge_positions.csv'), index=False)\n"
   ]
  },
