   "source": [
    "# Build URL co-action networks from original, non-retweet/non-quote tweets.\n",
    "# Restrict the actors to the filtered retweet-network giant component so the\n",
    "# networks can be compared with Tasks 2.1-2.3 and used in Task 2.5.\n",
    "import json\n",
    "from collections import defaultdict, Counter\n",
    "from datetime import datetime\n",
    "from urllib.parse import urlsplit\n",
    "import time\n",
    "\n",
    "SOURCE = DATA / 'msd_strike.json'\n",
    "URL_EVENTS = defaultdict(set)       # canonical URL -> unique (timestamp, account) events\n",
    "kept_accounts = set(g_final.vs['name'])\n",
    "skip_hosts = {'twitter.com', 't.co', 'twimg.com', 'bit.ly', 'tinyurl.com', 'buff.ly', 'ow.ly'}\n",
    "line_count = qualifying_tweets = url_event_count = 0\n",
    "scan_started = time.perf_counter()\n",
    "\n",
    "with SOURCE.open(encoding='utf-8') as source:\n",
    "    for line in source:\n",
    "        line_count += 1\n",
    "        if line_count % 500_000 == 0:\n",
    "            print(f'Scanned {line_count:,} records in {time.perf_counter() - scan_started:.0f}s...', flush=True)\n",
    "        tweet = json.loads(line)\n",
    "        account = str(tweet.get('author_id', ''))\n",
    "        if account not in kept_accounts:\n",
    "            continue\n",
    "        refs = tweet.get('referenced_tweets') or []\n",
    "        if any(ref.get('type') in {'retweeted', 'quoted'} for ref in refs):\n",
    "            continue\n",
    "        created = tweet.get('created_at')\n",
    "        if not created:\n",
    "            continue\n",
    "        timestamp = int(datetime.fromisoformat(created.replace('Z', '+00:00')).timestamp())\n",
    "        urls_in_tweet = set()\n",
    "        for entity in (tweet.get('entities') or {}).get('urls', []):\n",
    "            raw = (entity.get('expanded_url') or entity.get('url') or '').replace('&amp;', '&').strip()\n",
    "            if not raw:\n",
    "                continue\n",
    "            try:\n",
    "                parsed = urlsplit(raw if '://' in raw else 'https://' + raw)\n",
    "                host = (parsed.hostname or '').lower()\n",
    "            except ValueError:\n",
    "                continue\n",
    "            host = host.removeprefix('www.')\n",
    "            if (not host or host in skip_hosts or host.endswith('.twitter.com')\n",
    "                    or host.endswith('.twimg.com')):\n",
    "                continue\n",
    "            # Remove query strings and fragments to collapse tracking variants.\n",
    "            canonical = host + (parsed.path.rstrip('/') or '/')\n",
    "            urls_in_tweet.add(canonical)\n",
    "        if urls_in_tweet:\n",
    "            qualifying_tweets += 1\n",
    "            for url in urls_in_tweet:\n",
    "                URL_EVENTS[url].add((timestamp, account))\n",
    "                url_event_count += 1\n",
    "\n",
    "print(f'Scanned {line_count:,} JSON records; {qualifying_tweets:,} qualifying account-tweets '\n",
    "      f'contained {url_event_count:,} external URL events across {len(URL_EVENTS):,} URLs.')\n",
    "\n",
    "# Bot-candidate network: exact external URL, posted within 1 second; report\n",
    "# r=2 first. If no repeated pairs exist, keep the r=1 events as candidates\n",
    "# and explicitly treat them as leads rather than evidence of automation.\n",
    "bot_1s = Counter()\n",
    "bot_10s = Counter()\n",
    "for url, events in URL_EVENTS.items():\n",
    "    ordered = sorted(events)\n",
    "    for i, (time_a, account_a) in enumerate(ordered):\n",
    "        j = i + 1\n",
    "        while j < len(ordered) and ordered[j][0] - time_a <= 10:\n",
    "            time_b, account_b = ordered[j]\n",
    "            if account_a != account_b:\n",
    "                pair = tuple(sorted((account_a, account_b)))\n",
    "                bot_10s[pair] += 1\n",
    "                if time_b - time_a <= 1:\n",
    "                    bot_1s[pair] += 1\n",
    "            j += 1\n",
    "print('Synchronous-pair counts:',\n",
    "      f'1s / r>=1: {sum(v >= 1 for v in bot_1s.values()):,};',\n",
    "      f'1s / r>=2: {sum(v >= 2 for v in bot_1s.values()):,};',\n",
    "      f'10s / r>=2: {sum(v >= 2 for v in bot_10s.values()):,}.')\n",
    "BOT_S, BOT_R = (1, 2) if any(v >= 2 for v in bot_1s.values()) else (10, 2)\n",
    "BOT_PAIRS = {pair: n for pair, n in (bot_1s if BOT_S == 1 else bot_10s).items() if n >= BOT_R}\n",
    "if not BOT_PAIRS:\n",
    "    BOT_S, BOT_R = 1, 1\n",
    "    BOT_PAIRS = dict(bot_1s)\n",
    "print(f'Bot-candidate parameters: s={BOT_S}s, r={BOT_R}; '\n",
    "      f'{len(BOT_PAIRS):,} ties. These are screening candidates, not bot classifications.')\n",
    "\n",
    "# Topic/ideology network: pairs must co-share at least two distinct canonical\n",
    "# URLs, with each shared URL posted within 30 days by both accounts.\n",
    "IDEO_S = 30 * 24 * 60 * 60\n",
    "IDEO_R = 2\n",
    "ideo_pairs = Counter()\n",
    "skipped_popular_urls = 0\n",
    "for url, events in URL_EVENTS.items():\n",
    "    by_account = defaultdict(list)\n",
    "    for timestamp, account in events:\n",
    "        by_account[account].append(timestamp)\n",
    "    accounts = sorted(by_account)\n",
    "    # Extremely popular URLs such as broad portals are not discriminating.\n",
    "    if len(accounts) > 500:\n",
    "        skipped_popular_urls += 1\n",
    "        continue\n",
    "    for i, account_a in enumerate(accounts):\n",
    "        times_a = sorted(by_account[account_a])\n",
    "        for account_b in accounts[i + 1:]:\n",
    "            times_b = sorted(by_account[account_b])\n",
    "            ia = ib = 0\n",
    "            close = False\n",
    "            while ia < len(times_a) and ib < len(times_b):\n",
    "                delta = times_a[ia] - times_b[ib]\n",
    "                if abs(delta) <= IDEO_S:\n",
    "                    close = True\n",
    "                    break\n",
    "                if delta < 0:\n",
    "                    ia += 1\n",
    "                else:\n",
    "                    ib += 1\n",
    "            if close:\n",
    "                ideo_pairs[(account_a, account_b)] += 1\n",
    "IDEO_PAIRS = {pair: n for pair, n in ideo_pairs.items() if n >= IDEO_R}\n",
    "print(f'URL-sharing parameters: s=30 days, r={IDEO_R} distinct URLs; '\n",
    "      f'{len(IDEO_PAIRS):,} ties; skipped {skipped_popular_urls} URLs with >500 accounts.')\n",
    "\n",
    "def graph_from_pairs(pair_counts):\n",
    "    names = sorted({account for pair in pair_counts for account in pair})\n",
    "    index = {account: i for i, account in enumerate(names)}\n",
    "    edges = [tuple(index[account] for account in pair) for pair in pair_counts]\n",
    "    graph = ig.Graph(n=len(names), edges=edges, directed=False)\n",
    "    graph.vs['name'] = names\n",
    "    graph.es['weight'] = list(pair_counts.values())\n",
    "    return graph\n",
    "\n",
    "g_bot = graph_from_pairs(BOT_PAIRS)\n",
    "g_ideo = graph_from_pairs(IDEO_PAIRS)\n",
    "for name, graph in [('synchronized URL', g_bot), ('repeated URL sharing', g_ideo)]:\n",
    "    components = sorted(graph.connected_components().sizes(), reverse=True) if graph.vcount() else []\n",
    "    print(f'{name}: {graph.vcount():,} nodes, {graph.ecount():,} ties; '\n",
    "          f'largest components {components[:5]}')\n",
    "    graph.write_graphml(str(DATA / (name.replace(' ', '_') + '.graphml')))\n",
    "    pd.DataFrame([(graph.vs[u]['name'], graph.vs[v]['name'], graph.es[e]['weight'])\n",
    "                  for e, (u, v) in enumerate(graph.get_edgelist())],\n",
    "                 columns=['account_a', 'account_b', 'co_actions']).to_csv(\n",
    "                     str(DATA / (name.replace(' ', '_') + '_edges.csv')), index=False)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "48f1422f-f760-42ce-acdc-691ab9f988f8",
   "metadata": {
    "id": "48f1422f-f760-42ce-acdc-691ab9f988f8"
   },
   "source": [
    "#### Notes / observations\n",
    "\n",
    "The data is sparse: only 7,557 original tweets from the 4,213 filtered accounts contain an external URL. The bot-candidate network is essentially empty, with no pairs posting the same URL within 1 second and a single tie between 2 accounts at 10 seconds with r ≥ 2. So there is no sign of synchronised posting, which may partly reflect that the accounts were selected for retweet activity and that retweets and shorteners were excluded. The topical co-sharing network (30 days, r ≥ 2 distinct URLs) has 139 nodes and 176 ties, with one 69-account component and a few small ones. The 30-day window probably covers most of the data, so it captures shared URLs rather than timing.\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a3335adf-3303-46c2-a252-e4932b88b9fc",
   "metadata": {
    "id": "a3335adf-3303-46c2-a252-e4932b88b9fc"
   },
   "source": [
    "### Task 2.5\n",
    "\n",
    "Now choose one (or just a few) communities you produced in the previous task, either representing potential bots or an ideologically-cohese group defined by co-retweeting or co-sharing: your choice, also depending on what you found in your data! Characterise some of the accounts in that community using a combination of actor-level network metrics and qualitative analysis."
   ]
  },
