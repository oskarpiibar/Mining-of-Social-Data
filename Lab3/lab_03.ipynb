   "source": [
    "# Select an exact bridge position with at least two actors. Use the two-actor\n",
    "# position (2, 4) when present; otherwise choose a small exact position linking\n",
    "# two communities so the actors can be inspected individually.\n",
    "TARGET_POSITION = (2, 4)\n",
    "if TARGET_POSITION not in position_groups or len(position_groups[TARGET_POSITION]) < 2:\n",
    "    candidates = [(signature, actors) for signature, actors in position_groups.items()\n",
    "                  if len(signature) == 2 and 2 <= len(actors) <= 12]\n",
    "    if not candidates:\n",
    "        candidates = [(signature, actors) for signature, actors in position_groups.items()\n",
    "                      if len(signature) >= 2 and len(actors) >= 2]\n",
    "    if not candidates:\n",
    "        raise ValueError('No bridge position with at least two actors was found; run Task 3.1 first.')\n",
    "    TARGET_POSITION, _ = min(candidates, key=lambda item: (len(item[1]), item[0]))\n",
    "\n",
    "position_members = position_groups[TARGET_POSITION]\n",
    "print(f'Position {TARGET_POSITION}: {len(position_members)} actors; '\n",
    "      f'each reaches the same {len(TARGET_POSITION)} outside communities.')\n",
    "\n",
    "# Compare prominence and reach across the two sides of the retweet network.\n",
    "actor_rows = []\n",
    "for actor in position_members:\n",
    "    neighbor_communities = Counter(\n",
    "        int(position_memb[neighbor]) for neighbor in position_graph.neighbors(actor)\n",
    "        if position_memb[neighbor] != position_memb[actor]\n",
    "    )\n",
    "    row = {\n",
    "        'account_id': position_graph.vs[actor]['name'],\n",
    "        'own_community': int(position_memb[actor]),\n",
    "        'bridge_communities': ','.join(map(str, TARGET_POSITION)),\n",
    "        'degree': position_graph.degree(actor),\n",
    "        'weighted_strength': position_graph.strength(actor, weights='weight'),\n",
    "    }\n",
    "    for community in TARGET_POSITION:\n",
    "        row[f'ties_to_community_{community}'] = neighbor_communities[community]\n",
    "    actor_rows.append(row)\n",
    "\n",
    "position_actor_table = pd.DataFrame(actor_rows).sort_values(\n",
    "    ['weighted_strength', 'degree'], ascending=False\n",
    ")\n",
    "account_info = pd.read_csv(DATA / 'account_groups.csv', dtype={'account_id': str})\n",
    "display(position_actor_table.merge(account_info, on='account_id', how='left'))\n",
    "\n",
    "# Read authored non-retweet posts for these actors. The text and hashtags add\n",
    "# qualitative context to the structural equivalence shown above.\n",
    "position_ids = set(position_actor_table['account_id'])\n",
    "tweet_chunks = pd.read_csv(\n",
    "    DATA / 'original_tweets.csv',\n",
    "    usecols=['author_id', 'created_at', 'text', 'hashtags'],\n",
    "    dtype={'author_id': str}, chunksize=50000\n",
    ")\n",
    "position_posts = []\n",
    "for chunk in tweet_chunks:\n",
    "    position_posts.extend(chunk[chunk['author_id'].isin(position_ids)].to_dict('records'))\n",
    "position_posts = pd.DataFrame(position_posts).sort_values('created_at')\n",
    "if not position_posts.empty:\n",
    "    display(position_posts[['author_id', 'created_at', 'hashtags', 'text']])\n",
    "else:\n",
    "    print('No authored non-retweet posts for these actors were present in the CSV.')\n"
