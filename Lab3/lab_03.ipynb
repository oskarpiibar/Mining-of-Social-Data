   "source": [
    "# candidate filters\n",
    "\n",
    "# Coreness depends on the graph it is computed on, so inside the giant component\n",
    "# it is recomputed, not reused from Task 1.2.\n",
    "giant = g.connected_components(mode='weak').giant()\n",
    "core_giant = np.array(giant.coreness(mode='all'))\n",
    "\n",
    "\n",
    "def graph_row(label, graph):\n",
    "    comps = graph.connected_components(mode='weak')\n",
    "    return {'option': label,\n",
    "            'nodes': graph.vcount(),\n",
    "            'edges': graph.ecount(),\n",
    "            '% of filtered nodes': round(100 * graph.vcount() / g.vcount(), 1),\n",
    "            'density': round(graph.density(), 5),\n",
    "            'weak components': len(comps)}\n",
    "\n",
    "\n",
    "rows = [graph_row('A: whole filtered network', g),\n",
    "        graph_row('B: giant weak component', giant)]\n",
    "for k in range(2, int(core_giant.max()) + 1):\n",
    "    sub = giant.induced_subgraph(np.where(core_giant >= k)[0].tolist())\n",
    "    rows.append(graph_row(f'C: giant component, {k}-core', sub))\n",
    "display(pd.DataFrame(rows).set_index('option'))\n",
    "\n",
    "USE_GIANT = True     # induce the network on the giant weak component?\n",
    "CORE_K = None        # None = no core filtering; e.g. 5 = additionally keep the 5-core\n",
    "\n",
    "g_final = g\n",
    "if USE_GIANT:\n",
    "    g_final = g_final.connected_components(mode='weak').giant()\n",
    "if CORE_K:\n",
    "    cn = np.array(g_final.coreness(mode='all'))\n",
    "    g_final = g_final.induced_subgraph(np.where(cn >= CORE_K)[0].tolist())\n",
    "    # a k-core can fall apart into several pieces: keep the largest one\n",
    "    g_final = g_final.connected_components(mode='weak').giant()\n",
    "\n",
    "print('final network:', g_final.summary())\n",
    "print('weak components:', len(g_final.connected_components(mode='weak')),\n",
    "      '| density:', round(g_final.density(), 5))\n",
    "\n",
    "# save for Parts 2 and 3\n",
    "# the pickle keeps direction, account IDs (name) and weights exactly as they are\n",
    "g_final.write_pickle('retweet_network_filtered.pickle')\n",
    "g_final.write_graphml('retweet_network_filtered.graphml')\n",
    "\n",
    "# plot the result\n",
    "name_to_idx = {n: i for i, n in enumerate(g.vs['name'])}\n",
    "final_layout = ig.Layout([layout[name_to_idx[n]] for n in g_final.vs['name']])\n",
    "\n",
    "g_final_draw = g_final.as_undirected(mode='collapse')                  # no arrowheads\n",
    "g_final_draw.es['color'] = [(0.2, 0.2, 0.2, 0.03)] * g_final_draw.ecount()   # transparent edges; use 0.02 if still too dark\n",
    "deg = np.array(g_final_draw.degree())\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 9))\n",
    "ig.plot(g_final_draw, target=ax, layout=final_layout,\n",
    "        vertex_color='#1f77b4',                                         # same blue as the giant component in 1.1\n",
    "        vertex_size=list(2 + 9 * np.sqrt(deg / deg.max())),             # size = degree\n",
    "        vertex_frame_width=0, edge_width=0.4)\n",
    "ax.set_title('Filtered network used in Parts 2 and 3 (size = degree)')\n",
    "ax.axis('off')\n",
    "plt.show()"
   ]
  },
