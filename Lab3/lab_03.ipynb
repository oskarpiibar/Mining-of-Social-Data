   "source": [
    "random.seed(42)                      # reproducible layouts\n",
    "\n",
    "# load\n",
    "# directed network saved in lab 2 (names = account IDs, weight = number of retweets)\n",
    "g_full = ig.read(DATA / retweet_network.ncol, format='ncol', directed=True)\n",
    "g_full.simplify(multiple=True, loops=True, combine_edges={'weight': 'sum'})   # removes self-loops\n",
    "print('full network    :', g_full.summary())\n",
    "\n",
    "# filter\n",
    "# same filter as lab 2: strength = retweets sent + received.\n",
    "# No giant-component step here: we want to see the small components too.\n",
    "MIN_STRENGTH = 50\n",
    "strength = np.array(g_full.strength(mode='all', weights='weight'))\n",
    "g = g_full.induced_subgraph(np.where(strength >= MIN_STRENGTH)[0].tolist())\n",
    "print('filtered network:', g.summary())\n",
    "\n",
    "# components\n",
    "weak = g.connected_components(mode='weak')\n",
    "strong = g.connected_components(mode='strong')\n",
    "\n",
    "\n",
    "def component_stats(cl, name):\n",
    "    sizes = sorted(cl.sizes(), reverse=True)\n",
    "    print(f'--- {name} components ---')\n",
    "    print(f'number of components    : {len(sizes)}')\n",
    "    print(f'largest component       : {sizes[0]} nodes ({sizes[0] / g.vcount():.1%} of the network)')\n",
    "    print(f'second largest          : {sizes[1] if len(sizes) > 1 else 0}')\n",
    "    print(f'singletons (size 1)     : {sum(s == 1 for s in sizes)}')\n",
    "    print(f'non-trivial (size >= 2) : {sum(s >= 2 for s in sizes)}')\n",
    "    print(f'10 largest sizes        : {sizes[:10]}')\n",
    "    print(f'size distribution       : {dict(sorted(Counter(sizes).items(), reverse=True)[:10])}')\n",
    "    print()\n",
    "\n",
    "\n",
    "component_stats(weak, 'WEAK')\n",
    "component_stats(strong, 'STRONG')\n",
    "\n",
    "# plot\n",
    "layout = g.layout_fruchterman_reingold() if g.vcount() <= 1500 else g.layout_drl()\n",
    "\n",
    "# undirected copy only for drawing: same vertex order (so layout and colours still match),\n",
    "# and no arrowheads covering the nodes\n",
    "g_draw = g.as_undirected(mode='collapse')\n",
    "# transparent edges, set as an edge attribute (this is what igraph's matplotlib backend respects);\n",
    "# lower the 0.03 if the nodes are still hidden, raise it if the edges are invisible\n",
    "g_draw.es['color'] = [(0.2, 0.2, 0.2, 0.03)] * g_draw.ecount()\n",
    "\n",
    "\n",
    "def component_colors(cl, n_colored=8, other='#d0d0d0'):\n",
    "    \"\"\"One colour for each of the n_colored largest components, grey for all the others.\"\"\"\n",
    "    order = sorted(range(len(cl)), key=lambda i: -len(cl[i]))\n",
    "    palette = [to_hex(c) for c in plt.get_cmap('tab10').colors]\n",
    "    cmap = {comp: palette[r] for r, comp in enumerate(order[:n_colored])}\n",
    "    return [cmap.get(m, other) for m in cl.membership]\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 8))\n",
    "for ax, cl, name, n_col in [(axes[0], weak, 'Weak', 2), (axes[1], strong, 'Strong', 3)]:\n",
    "    ig.plot(g_draw, target=ax, layout=layout,\n",
    "            vertex_color=component_colors(cl, n_colored=n_col),\n",
    "            vertex_size=4, vertex_frame_width=0, edge_width=0.4)\n",
    "    ax.set_title(f'{name} components ({len(cl)}); {n_col} largest coloured')\n",
    "    ax.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
