      "source": [
        "# pairwise comparison of all community structures with NMI\n",
        "# NMI = mutual information between the two partitions, normalised to 0-1 (1 = identical, 0 = independent)\n",
        "# Other option would be Rand index, which counts pairs of accounts that are placed together or apart in both partitions.\n",
        "names = list(partitions)\n",
        "nmi = pd.DataFrame(index=names, columns=names, dtype=float)\n",
        "for a in names:\n",
        "    for b in names:\n",
        "        nmi.loc[a, b] = ig.compare_communities(partitions[a], partitions[b], method='nmi')\n",
        "display(nmi.round(2))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(8, 6.5))\n",
        "im = ax.imshow(nmi.values, vmin=0, vmax=1, cmap='viridis')\n",
        "ax.set_xticks(range(len(names)))\n",
        "ax.set_xticklabels(names, rotation=45, ha='right')\n",
        "ax.set_yticks(range(len(names)))\n",
        "ax.set_yticklabels(names)\n",
        "for i in range(len(names)):\n",
        "    for j in range(len(names)):\n",
        "        ax.text(j, i, f'{nmi.values[i, j]:.2f}', ha='center', va='center',\n",
        "                color='white' if nmi.values[i, j] < 0.6 else 'black', fontsize=9)\n",
        "ax.set_title('NMI between community structures')\n",
        "fig.colorbar(im, ax=ax, shrink=0.8)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
