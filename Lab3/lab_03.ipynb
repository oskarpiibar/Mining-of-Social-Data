      "non-trivial (size >= 2) : 49\n",
      "10 largest sizes        : [1500, 10, 9, 8, 6, 5, 4, 4, 4, 4]\n",
      "size distribution       : {1500: 1, 10: 1, 9: 1, 8: 1, 6: 1, 5: 1, 4: 5, 3: 3, 2: 35, 1: 4011}\n",
      "\n"
     ]
    },
    {
     "data": {
