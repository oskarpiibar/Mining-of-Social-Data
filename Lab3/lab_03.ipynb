    "# Choose the largest non-singleton community in the repeated-URL network.\n",
    "# This network links accounts that independently shared at least two of the\n",
    "# same external URLs within 30 days.\n",
    "url_cl = g_ideo.community_multilevel(weights='weight')\n",
    "url_memb = np.asarray(url_cl.membership)\n",
    "url_sizes = Counter(url_memb.tolist())\n",
    "url_community_table = pd.DataFrame([\n",
    "    {'community': c, 'accounts': n, 'share of URL-network': n / g_ideo.vcount()}\n",
    "    for c, n in url_sizes.most_common()\n",
    "])\n",
    "display(url_community_table.head(10))\n",
    "selected_url_community = next(c for c, n in url_sizes.most_common() if n >= 3)\n",
    "selected_url_ids = {g_ideo.vs[i]['name'] for i, c in enumerate(url_memb)\n",
    "                    if c == selected_url_community}\n",
    "print(f'Selected URL-sharing community {selected_url_community}: '\n",
    "      f'{len(selected_url_ids)} accounts.')\n",
    "\n",
    "# Actor-level measures within the co-sharing network.\n",
    "url_degree = np.asarray(g_ideo.degree())\n",
    "url_strength = np.asarray(g_ideo.strength(weights='weight'))\n",
    "url_betweenness = np.asarray(g_ideo.betweenness())\n",
    "selected_idx = [i for i, c in enumerate(url_memb) if c == selected_url_community]\n",
    "actor_table = pd.DataFrame({\n",
    "    'account_id': [g_ideo.vs[i]['name'] for i in selected_idx],\n",
    "    'co-sharing degree': url_degree[selected_idx],\n",
    "    'shared-URL tie weight': url_strength[selected_idx],\n",
    "    'betweenness': url_betweenness[selected_idx],\n",
    "}).sort_values(['shared-URL tie weight', 'co-sharing degree'], ascending=False)\n",
    "display(actor_table.head(10))\n",
    "\n",
    "# Add stance/activity indicators from the lab's account-level summary and a\n",
    "# small sample of authored tweets for qualitative context.\n",
    "chosen_ids = set(actor_table.head(8)['account_id'])\n",
    "account_info = pd.read_csv(DATA / 'account_groups.csv', dtype={'account_id': str})\n",
    "display(actor_table.head(8).merge(account_info, on='account_id', how='left'))\n",
    "tweet_chunks = pd.read_csv(DATA / 'original_tweets.csv',\n",
    "                           usecols=['author_id', 'created_at', 'text', 'hashtags'],\n",
    "                           dtype={'author_id': str}, chunksize=50000)\n",
    "examples = []\n",
    "for chunk in tweet_chunks:\n",
    "    examples.extend(chunk[chunk['author_id'].isin(chosen_ids)].to_dict('records'))\n",
    "examples = (pd.DataFrame(examples).sort_values('created_at')\n",
    "            .groupby('author_id', group_keys=False).tail(2))\n",
    "if not examples.empty:\n",
    "    display(examples[['author_id', 'created_at', 'hashtags', 'text']])\n"
   ]
  },
