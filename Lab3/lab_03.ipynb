   "source": [
    "# coreness\n",
    "# mode=\"all\" ignores edge direction (the standard k-core);\n",
    "# \"in\" / \"out\" give the directed versions (only edges received / sent count).\n",
    "core_all = np.array(g.coreness(mode='all'))\n",
    "core_in = np.array(g.coreness(mode='in'))\n",
    "core_out = np.array(g.coreness(mode='out'))\n",
    "\n",
    "kmax = int(core_all.max())\n",
    "print(f'Highest coreness (all): {kmax}')\n",
    "print(f'Highest coreness (in) : {core_in.max()}')\n",
    "print(f'Highest coreness (out): {core_out.max()}')\n",
    "print('\\nNodes per coreness value (all):')\n",
    "print(dict(sorted(Counter(core_all.tolist()).items())))\n",
    "\n",
    "\n",
    "#  how does the core change with k?\n",
    "def core_summary(graph, coreness, ks):\n",
    "    rows = []\n",
    "    for k in ks:\n",
    "        sub = graph.induced_subgraph(np.where(coreness >= k)[0].tolist())\n",
    "        sizes = sorted(sub.connected_components(mode='weak').sizes(), reverse=True)\n",
    "        rows.append({'k': k,\n",
    "                     'nodes': sub.vcount(),\n",
    "                     'edges': sub.ecount(),\n",
    "                     'weak components': len(sizes),\n",
    "                     'largest component': sizes[0] if sizes else 0,\n",
    "                     'second largest': sizes[1] if len(sizes) > 1 else 0})\n",
    "    return pd.DataFrame(rows).set_index('k')\n",
    "\n",
    "\n",
    "display(core_summary(g, core_all, range(1, kmax + 1)))\n",
    "\n",
    "# plots\n",
    "# values of k to highlight (replace with your own list)\n",
    "KS = [2, 18, 34, 50]\n",
    "\n",
    "fig, axes = plt.subplots(1, len(KS), figsize=(6 * len(KS), 6))\n",
    "for ax, k in zip(np.atleast_1d(axes), KS):\n",
    "    in_core = core_all >= k\n",
    "    ig.plot(g_draw, target=ax, layout=layout,                  # g_draw and edge_col come from Task 1.1\n",
    "            vertex_color=['#d62728' if x else '#d0d0d0' for x in in_core],     # red = in the k-core\n",
    "            vertex_size=[7 if x else 3 for x in in_core],\n",
    "            vertex_frame_width=0, edge_width=0.3, edge_color=g_draw.es['color'])\n",
    "    ax.set_title(f'coreness >= {k}  ({in_core.sum()} nodes)')\n",
    "    ax.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
